PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://motile:motile@localhost:5435/motile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in without Google. For local work only.
DEV_LOGIN=1
# The web app (apps/web), which may start sign-ins.
WEB_URL=http://localhost:3001
# Pushes to phones, all optional: without them, nothing is pushed. APNS_KEY is the .p8 file's text.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# The Firebase service account's JSON, on one line.
FCM_SERVICE_ACCOUNT=
# Stand-ins for Apple's and Google's push services, for tests.
# APNS_URL=http://127.0.0.1:9000
# FCM_URL=http://127.0.0.1:9000
# FCM_TOKEN_URL=http://127.0.0.1:9000/token
