---
import "@/styles/global.css"
import Logo from "@/components/logo.astro"
import { GITHUB_URL, TAGLINE, WEB_APP_URL } from "@/lib/links"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title,
  description = "Run Claude Code and Codex on machines you own, and drive them from a native app.",
  image,
} = Astro.props
const fullTitle = title ? `${title} · Motile` : `Motile · ${TAGLINE}`
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="theme-color"
      content="#f8f9fc"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#08090d"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
  </head>
  <body class="flex min-h-svh flex-col">
    <header class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2 font-medium tracking-tight">
        <Logo />
        Motile
      </a>
      <nav class="flex items-center gap-6 text-sm text-muted-foreground">
        <a href={GITHUB_URL} class="transition-colors hover:text-foreground">
          GitHub
        </a>
        <a href={WEB_APP_URL} class="transition-colors hover:text-foreground">
          Sign in
        </a>
      </nav>
    </header>
    <div class="flex-1">
      <slot />
    </div>
    <footer class="mx-auto flex w-full max-w-5xl flex-wrap gap-x-6 gap-y-2 border-t px-6 py-6 text-sm text-muted-foreground">
      <span class="mr-auto">Motile</span>
      <a href="/privacy/" class="transition-colors hover:text-foreground">
        Privacy
      </a>
      <a href="/terms/" class="transition-colors hover:text-foreground">
        Terms
      </a>
      <a href={GITHUB_URL} class="transition-colors hover:text-foreground">
        GitHub
      </a>
    </footer>
  </body>
</html>
