---
import "@/styles/global.css"
import Logo from "@/components/logo.astro"
import ThemeToggle from "@/components/theme-toggle.astro"
import { LinkButton } from "@/components/link-button"
import { GITHUB_URL, TAGLINE, WEB_APP_URL } from "@/lib/links"
import { THEME_SCRIPT } from "@/lib/theme"

interface Props {
  title?: string
  description?: string
}

const {
  title,
  description = "Run Claude Code and Codex on your own servers. Steer every thread from a native Mac app: opens in under a second, connects in 1/10th.",
} = Astro.props
const fullTitle = title ? `${title} · Motile` : `Motile · ${TAGLINE}`
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_SCRIPT} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/preview.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TAGLINE} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-svh flex-col">
    <header class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4">
      <LinkButton
        href="/"
        variant="ghost"
        className="-ml-3.25 gap-2 text-base tracking-tight text-foreground"
      >
        <Logo />
        Motile
      </LinkButton>
      <nav class="flex items-center gap-1 text-muted-foreground">
        <LinkButton
          target="_blank"
          rel="noreferrer"
          href={GITHUB_URL}
          variant="ghost"
        >
          GitHub
        </LinkButton>
        <LinkButton href={WEB_APP_URL} variant="ghost">
          Sign in
        </LinkButton>
        <ThemeToggle />
      </nav>
    </header>
    <div class="flex-1">
      <slot />
    </div>
    <footer class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-1 border-t px-4 py-4 text-muted-foreground">
      <span class="mr-auto text-sm">Motile</span>
      <LinkButton
        target="_blank"
        rel="noreferrer"
        href="/privacy/"
        variant="ghost"
        size="sm"
      >
        Privacy
      </LinkButton>
      <LinkButton
        target="_blank"
        rel="noreferrer"
        href="/terms/"
        variant="ghost"
        size="sm"
      >
        Terms
      </LinkButton>
      <LinkButton
        target="_blank"
        rel="noreferrer"
        href={GITHUB_URL}
        variant="ghost"
        size="sm"
        className="-mr-3.25"
      >
        GitHub
      </LinkButton>
    </footer>
  </body>
</html>
