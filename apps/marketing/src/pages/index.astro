---
import { RouteIcon, ServerIcon, ZapIcon } from "lucide-react"
import Layout from "@/layouts/main.astro"
import AppleIcon from "@/components/apple-icon.astro"
import GithubIcon from "@/components/github-icon.astro"
import { Demo } from "@/components/demo/demo"
import { LinkButton } from "@/components/link-button"
import { DOWNLOAD_URL, GITHUB_URL, TAGLINE } from "@/lib/links"

const features = [
  {
    icon: ZapIcon,
    title: "Native",
    text: "Motile is a real Mac app. It opens in under a second and reaches your server in under 1/10th of a second.",
  },
  {
    icon: ServerIcon,
    title: "Your servers",
    text: "Agents run on your Mac or Linux box, with your tools and your keys. They keep going after you close the window.",
  },
  {
    icon: RouteIcon,
    title: "Nothing in between",
    text: "Your Mac connects straight to your server, encrypted end to end. No ports to open, and we never see a thread.",
  },
]
---

<Layout>
  <main class="overflow-x-clip pb-24">
    <section class="relative z-10 mx-auto flex max-w-5xl flex-col items-center px-6 pt-10 text-center sm:pt-14">
      <h1 class="max-w-[16ch] text-4xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl">
        {TAGLINE}
      </h1>
      <p class="mt-5 max-w-md text-lg text-pretty text-muted-foreground">
        Run Claude Code and Codex on your own servers. Steer every thread from
        a native Mac app: opens in under a second, connects in 1/10th.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <LinkButton
          target="_blank"
          rel="noreferrer"
          href={DOWNLOAD_URL}
          size="lg"
        >
          <AppleIcon />
          Download for macOS
        </LinkButton>
        <LinkButton
          target="_blank"
          rel="noreferrer"
          href={GITHUB_URL}
          size="lg"
          variant="outline"
        >
          <GithubIcon />
          View the source
        </LinkButton>
      </div>
    </section>

    <section class="mx-auto mt-8 max-w-[1248px] px-3 sm:mt-10 sm:px-6">
      <div data-demo-frame>
        <Demo client:load />
      </div>
      <script is:inline>
        // Safari can paint a stale cqw, so the demo's scale is measured before the first paint.
        {
          const frame = document.querySelector("[data-demo-frame]")
          const fit = () =>
            frame.style.setProperty(
              "--demo-fit",
              Math.min(1, frame.clientWidth / 1200)
            )
          fit()
          new ResizeObserver(fit).observe(frame)
        }
      </script>
      <p class="relative mt-5 text-center text-sm text-muted-foreground">
        A live demo. Open a thread, answer the agent, look at the diff.
      </p>
    </section>

    <section class="mx-auto mt-24 grid max-w-5xl gap-10 px-6 sm:mt-32 sm:grid-cols-3">
      {features.map((feature) => (
        <div>
          <feature.icon className="size-5 text-primary" />
          <h2 class="mt-4 font-medium">{feature.title}</h2>
          <p class="mt-1.5 text-pretty text-muted-foreground">{feature.text}</p>
        </div>
      ))}
    </section>
  </main>
</Layout>
