---
import { getImage } from "astro:assets"
import { LayersIcon, RouteIcon, ServerIcon } from "lucide-react"
import Layout from "@/layouts/main.astro"
import { Demo } from "@/components/demo/demo"
import { LinkButton } from "@/components/link-button"
import { DOWNLOAD_URL, GITHUB_URL, TAGLINE } from "@/lib/links"
import thread from "@/assets/thread-light.png"

const preview = await getImage({ src: thread, format: "webp" })

const features = [
  {
    icon: ServerIcon,
    title: "Your machines",
    text: "Agents run on your Mac or Linux box, with your tools and your keys. They keep going after you close the window.",
  },
  {
    icon: RouteIcon,
    title: "Nothing in between",
    text: "Your Mac connects straight to your server, encrypted end to end. No ports to open, and we never see a thread.",
  },
  {
    icon: LayersIcon,
    title: "Every thread at a glance",
    text: "See which agents are working, which need you and what each one changed, on all your servers.",
  },
]
---

<Layout image={preview.src}>
  <main class="pb-24">
    <section class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-16 text-center sm:pt-24">
      <h1 class="max-w-[16ch] text-4xl leading-[1.05] font-medium tracking-tight text-balance sm:text-6xl">
        {TAGLINE}
      </h1>
      <p class="mt-5 max-w-md text-lg text-pretty text-muted-foreground">
        Run Claude Code and Codex on your own machines. Steer every thread from
        your Mac.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <LinkButton href={DOWNLOAD_URL} size="lg">
          Download for macOS
        </LinkButton>
        <LinkButton href={GITHUB_URL} size="lg" variant="outline">
          View the source
        </LinkButton>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        Free and open source. macOS 14 or later on Apple silicon.
      </p>
    </section>

    <section class="mx-auto mt-14 max-w-[1248px] px-6 sm:mt-20">
      <Demo client:load />
      <p class="mt-5 text-center text-sm text-muted-foreground">
        A live demo. Open a thread, answer the agent, look at the diff.
      </p>
    </section>

    <section class="mx-auto mt-24 grid max-w-5xl gap-10 px-6 sm:mt-32 sm:grid-cols-3">
      {features.map((feature) => (
        <div>
          <feature.icon className="size-5 text-primary" />
          <h2 class="mt-4 font-medium">{feature.title}</h2>
          <p class="mt-1.5 text-pretty text-muted-foreground">{feature.text}</p>
        </div>
      ))}
    </section>
  </main>
</Layout>
