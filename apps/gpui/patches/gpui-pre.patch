+    /// Prepaints what `f` prepaints for [`Self::paint_scaled`], `scale` times its size around
+    /// `origin`, which stays where it is. What it prepaints takes no part in hit testing.
+    pub fn prepaint_scaled<R>(
+        &mut self,
+        origin: Point<Pixels>,
+        scale: f32,
+        f: impl FnOnce(&mut Self) -> R,
+    ) -> R {
+        self.invalidator.debug_assert_prepaint();
+        self.content_mask_stack.push(ContentMask::default());
+        let result = self.with_element_offset(origin * (1. / scale - 1.), f);
+        self.content_mask_stack.pop();
+        result
+    }
+
+    /// Paints what `f` paints `scale` times its size, around the origin it was prepainted for.
+    pub fn paint_scaled<R>(&mut self, scale: f32, f: impl FnOnce(&mut Self) -> R) -> R {
+        self.invalidator.debug_assert_paint();
+        let mask = self.content_mask().bounds;
+        self.content_mask_stack.push(ContentMask {
+            bounds: Bounds::new(
+                mask.origin * (1. / scale),
+                size(mask.size.width / scale, mask.size.height / scale),
+            ),
+        });
+        let scale_factor = self.scale_factor;
+        self.scale_factor = scale_factor * scale;
+        let result = f(self);
+        self.scale_factor = scale_factor;
+        self.content_mask_stack.pop();
+        result
+    }
+
