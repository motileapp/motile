index 0000000..b27121b
--- /dev/null
+++ b/src/scene_damage.rs
@@ -0,0 +1,181 @@
+use crate::{Bounds, Path, Point, ScaledPixels, Scene, Size, TransformationMatrix};
+use collections::FxHashMap;
+
+/// The most rectangles damage is kept in; more are merged into the nearest.
+pub const MAX_DAMAGE_RECTS: usize = 4;
+
+/// The part of the window that changed between two frames, in device pixels.
+#[derive(Clone, Debug, PartialEq)]
+pub enum SceneDamage {
+    /// Everything must be redrawn.
+    Full,
+    /// Only these rectangles changed, at most [`MAX_DAMAGE_RECTS`] of them.
+    Rects(Vec<Bounds<ScaledPixels>>),
+    /// Nothing changed.
+    Unchanged,
+}
+
+impl SceneDamage {
+    /// Covers every pixel that differs between two finished scenes, and possibly more.
+    pub fn between(prev: &Scene, next: &Scene) -> SceneDamage {
+        if prev.surfaces.len() + next.surfaces.len() > 0 {
+            return SceneDamage::Full;
+        }
+        let mut damage = Vec::new();
+        diff(&prev.quads, &next.quads, |q| q.bounds, &mut damage);
+        diff(
+            &prev.shadows,
+            &next.shadows,
+            |s| s.bounds.dilate(s.blur_radius * 3.0),
+            &mut damage,
+        );
+        diff(
+            &prev.underlines,
+            &next.underlines,
+            |u| u.bounds,
+            &mut damage,
+        );
+        diff(
+            &prev.monochrome_sprites,
+            &next.monochrome_sprites,
+            |s| transformed_bounds(s.bounds, &s.transformation),
+            &mut damage,
+        );
+        diff(
+            &prev.subpixel_sprites,
+            &next.subpixel_sprites,
+            |s| transformed_bounds(s.bounds, &s.transformation),
+            &mut damage,
+        );
+        diff(
+            &prev.polychrome_sprites,
+            &next.polychrome_sprites,
+            |s| s.bounds,
+            &mut damage,
+        );
+        diff_paths(&prev.paths, &next.paths, &mut damage);
+
+        if damage.is_empty() {
+            return SceneDamage::Unchanged;
+        }
+        SceneDamage::Rects(damage)
+    }
+
+    /// Covers both, for frames drawn but not yet presented.
+    pub fn union(self, other: SceneDamage) -> SceneDamage {
+        match (self, other) {
+            (SceneDamage::Full, _) | (_, SceneDamage::Full) => SceneDamage::Full,
+            (SceneDamage::Unchanged, damage) | (damage, SceneDamage::Unchanged) => damage,
+            (SceneDamage::Rects(mut rects), SceneDamage::Rects(others)) => {
+                for rect in others {
+                    add(&mut rects, rect);
+                }
+                SceneDamage::Rects(rects)
+            }
+        }
+    }
+}
+
+fn add(rects: &mut Vec<Bounds<ScaledPixels>>, bounds: Bounds<ScaledPixels>) {
+    let mut grown = bounds;
+    while let Some(index) = rects.iter().position(|rect| rect.intersects(&grown)) {
+        grown = grown.union(&rects.swap_remove(index));
+    }
+    if rects.len() < MAX_DAMAGE_RECTS {
+        rects.push(grown);
+        return;
+    }
+    let area = |rect: Bounds<ScaledPixels>| rect.size.width.0 * rect.size.height.0;
+    let growth = |rect: &Bounds<ScaledPixels>| area(rect.union(&grown)) - area(*rect);
+    let Some(nearest) =
+        (0..rects.len()).min_by(|&a, &b| growth(&rects[a]).total_cmp(&growth(&rects[b])))
+    else {
+        return;
+    };
+    let merged = rects.swap_remove(nearest).union(&grown);
+    add(rects, merged);
+}
+
+// The lists are sorted by draw order and then by atlas tile, not by position, so they are
+// compared as sets: a primitive changed if it is in one frame and not the other.
+fn diff<T: Copy>(
+    prev: &[T],
+    next: &[T],
+    bounds_of: impl Fn(&T) -> Bounds<ScaledPixels>,
+    damage: &mut Vec<Bounds<ScaledPixels>>,
+) {
+    let mut counts = FxHashMap::<&[u8], (isize, &T)>::default();
+    for (primitives, step) in [(prev, 1), (next, -1)] {
+        for primitive in primitives {
+            counts.entry(bytes(primitive)).or_insert((0, primitive)).0 += step;
+        }
+    }
+    for (count, primitive) in counts.into_values() {
+        if count != 0 {
+            add(damage, bounds_of(primitive));
+        }
+    }
+}
+
+// Primitives are uploaded to the GPU as these same bytes, so they hold no padding.
+fn bytes<T: Copy>(primitive: &T) -> &[u8] {
+    unsafe { std::slice::from_raw_parts((primitive as *const T).cast(), std::mem::size_of::<T>()) }
+}
+
+fn diff_paths(
+    prev: &[Path<ScaledPixels>],
+    next: &[Path<ScaledPixels>],
+    damage: &mut Vec<Bounds<ScaledPixels>>,
+) {
+    let equal = |a: &Path<ScaledPixels>, b: &Path<ScaledPixels>| {
+        a.order == b.order
+            && a.bounds == b.bounds
+            && a.content_mask == b.content_mask
+            && a.color == b.color
+            && a.vertices == b.vertices
+    };
+    let common = prev.len().min(next.len());
+    let prefix = (0..common)
+        .find(|&i| !equal(&prev[i], &next[i]))
+        .unwrap_or(common);
+    if prefix == prev.len() && prefix == next.len() {
+        return;
+    }
+    let suffix = (0..common - prefix)
+        .find(|&i| !equal(&prev[prev.len() - 1 - i], &next[next.len() - 1 - i]))
+        .unwrap_or(common - prefix);
+    for path in prev[prefix..prev.len() - suffix]
+        .iter()
+        .chain(&next[prefix..next.len() - suffix])
+    {
+        add(damage, path.bounds);
+    }
+}
+
+fn transformed_bounds(
+    bounds: Bounds<ScaledPixels>,
+    transform: &TransformationMatrix,
+) -> Bounds<ScaledPixels> {
+    let [[a, b], [c, d]] = transform.rotation_scale;
+    let [tx, ty] = transform.translation;
+    let left = bounds.origin.x.0;
+    let top = bounds.origin.y.0;
+    let right = left + bounds.size.width.0;
+    let bottom = top + bounds.size.height.0;
+    let corners = [(left, top), (right, top), (left, bottom), (right, bottom)]
+        .map(|(x, y)| (a * x + b * y + tx, c * x + d * y + ty));
+    let min_x = corners.iter().map(|p| p.0).fold(f32::MAX, f32::min);
+    let min_y = corners.iter().map(|p| p.1).fold(f32::MAX, f32::min);
+    let max_x = corners.iter().map(|p| p.0).fold(f32::MIN, f32::max);
+    let max_y = corners.iter().map(|p| p.1).fold(f32::MIN, f32::max);
+    Bounds {
+        origin: Point {
+            x: ScaledPixels(min_x),
+            y: ScaledPixels(min_y),
+        },
+        size: Size {
+            width: ScaledPixels(max_x - min_x),
+            height: ScaledPixels(max_y - min_y),
+        },
+    }
+}
