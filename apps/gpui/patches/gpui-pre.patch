+/// Moves every glyph at or after each byte of `spacing` right by the room before that byte.
+fn apply_spacing_to_layout(layout: &mut LineLayout, spacing: &[(usize, Pixels)]) {
+    if spacing.is_empty() {
+        return;
+    }
+    for run in layout.runs.iter_mut() {
+        for glyph in run.glyphs.iter_mut() {
+            glyph.position.x += room_before(spacing, glyph.index);
+        }
+    }
+    layout.width += room_before(spacing, layout.len);
+}
+
+fn room_before(spacing: &[(usize, Pixels)], index: usize) -> Pixels {
+    spacing.iter().filter(|(at, _)| *at <= index).map(|(_, room)| *room).sum()
+}
