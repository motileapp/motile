+    /// Draws only the damaged regions when the last presented frame can fill in the rest,
+    /// and returns them, or none when it drew everything.
+    fn render_damaged_frame(
+        &mut self,
+        scene: &Scene,
+        frame: &wgpu::Texture,
+        frame_view: &wgpu::TextureView,
+        size: Size<DevicePixels>,
+        premultiplied_alpha: bool,
+        damage: &SceneDamage,
+    ) -> Result<Vec<Region>> {
+        let whole = Region::whole(frame.width(), frame.height());
+        let has_presented_frame = self.ensure_presented_frame(frame);
+        let regions: Vec<Region> = match damage {
+            SceneDamage::Rects(rects) if has_presented_frame => rects
+                .iter()
+                .filter_map(|bounds| Region::covering(*bounds, whole.width, whole.height))
+                .collect(),
+            _ => Vec::new(),
+        };
+        if regions.is_empty() || regions.contains(&whole) {
+            self.render_frame(
+                scene,
+                frame_view,
+                size,
+                premultiplied_alpha,
+                wgpu::Color::TRANSPARENT,
+                None,
+            )?;
+            self.copy_to_presented_frame(frame, whole, false)?;
+            return Ok(Vec::new());
+        }
+
+        for region in &regions {
+            self.render_frame(
+                scene,
+                frame_view,
+                size,
+                premultiplied_alpha,
+                wgpu::Color::TRANSPARENT,
+                Some(*region),
+            )?;
+            self.copy_to_presented_frame(frame, *region, false)?;
+        }
+        self.copy_to_presented_frame(frame, whole, true)?;
+        Ok(regions)
+    }
+
+    /// Copies `region` of the frame into the presented frame, or back out of it.
+    fn copy_to_presented_frame(
+        &self,
+        frame: &wgpu::Texture,
+        region: Region,
+        back: bool,
+    ) -> Result<()> {
+        let presented_frame = self
+            .resources
+            .presented_frame
+            .as_ref()
+            .context("the presented frame was just created")?;
+        let (source, destination) = if back {
+            (presented_frame, frame)
+        } else {
+            (frame, presented_frame)
+        };
+        let mut encoder =
+            self.resources
+                .device
+                .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+                    label: Some("damage_encoder"),
+                });
+        encoder.copy_texture_to_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture: source,
+                mip_level: 0,
+                origin: region.origin(),
+                aspect: wgpu::TextureAspect::All,
+            },
+            wgpu::TexelCopyTextureInfo {
+                texture: destination,
+                mip_level: 0,
+                origin: region.origin(),
+                aspect: wgpu::TextureAspect::All,
+            },
+            region.extent(),
+        );
+        self.resources
+            .queue
+            .submit(std::iter::once(encoder.finish()));
+        Ok(())
+    }
+
+    /// Returns whether the presented frame already held the last frame at this size.
+    fn ensure_presented_frame(&mut self, frame: &wgpu::Texture) -> bool {
+        if self
+            .resources
+            .presented_frame
+            .as_ref()
+            .is_some_and(|texture| {
+                texture.size() == frame.size() && texture.format() == frame.format()
+            })
+        {
+            return true;
+        }
+        let texture = self
+            .resources
+            .device
+            .create_texture(&wgpu::TextureDescriptor {
+                label: Some("presented_frame"),
+                size: frame.size(),
+                mip_level_count: 1,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format: frame.format(),
+                usage: wgpu::TextureUsages::COPY_SRC | wgpu::TextureUsages::COPY_DST,
+                view_formats: &[],
+            });
+        self.resources.presented_frame = Some(texture);
+        false
+    }
