#!/usr/bin/env python3
"""Stand-in for GitHub's `gh`, for tests and the dev apps.

It keeps the pull requests of the repository it is run in in FAKE_GH_STATE, a JSON file beside it
unless that says where, and answers the calls the server makes: `pr view` and `pr create` for the
git button; `api graphql` for the pull request tab, its reactions, conversations and viewed files;
`pr list` for the list of pull requests; `pr diff` and `api …/commits/<sha>` for their changes;
`api …/stacks` for stacks; `api …/pulls/<n>/reviews` for a review with comments on lines; and
`pr merge`, `ready`, `close`, `reopen`, `update-branch`, `revert`, `comment`, `review` and `edit` for
what the tab does.

A new pull request's checks pass and it merges cleanly; to see it otherwise, edit the file. The
checks of a pull request are `[name, status]` pairs, a status being `success`, `failure`, `pending`
or another of GitHub's conclusions in lower case; `mergeable` is `MERGEABLE`, `CONFLICTING` or
`UNKNOWN`. Comments, reviews and conversations can be added to a pull request's `comments`,
`reviews` and `threads` as GitHub's API has them, and a stack to `stacks` as its REST API lists one.
A merge is only written down: the branches stay as they are. The user is `demo`. A `delay` in
the file, in seconds, slows down every call that changes something, to see a client wait.
"""
import json
import os
import subprocess
import sys
import time

STATE = os.environ.get("FAKE_GH_STATE") or os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "fake-gh.json")
REPOSITORY = "https://github.com/acme/app"
USER = "demo"
REACTIONS = ["THUMBS_UP", "THUMBS_DOWN", "LAUGH", "HOORAY", "CONFUSED", "HEART", "ROCKET", "EYES"]


def load():
    try:
        with open(STATE) as file:
            state = json.load(file)
    except FileNotFoundError:
        state = {}
    state.setdefault("pulls", [])
    state.setdefault("merge_methods", ["MERGE", "SQUASH", "REBASE"])
    state.setdefault("preferred", "SQUASH")
    state.setdefault("auto_merge", True)
    state.setdefault("labels", [{"name": "bug", "color": "d73a4a"}, {"name": "documentation", "color": "0075ca"},
                                {"name": "enhancement", "color": "a2eeef"}])
    state.setdefault("users", [USER, "ana", "bo"])
    state.setdefault("reactions", {})
    state.setdefault("stacks", [])
    state.setdefault("next_id", 1)
    for pull in state["pulls"]:
        for key, empty in (("comments", []), ("reviews", []), ("threads", []), ("labels", []), ("requested", []),
                           ("viewed", [])):
            pull.setdefault(key, empty)
    return state


def save(state):
    time.sleep(state.get("delay", 0))
    with open(STATE, "w") as file:
        json.dump(state, file, indent=2)


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def git(*arguments):
    return subprocess.run(["git", *arguments], capture_output=True, text=True).stdout.strip()


def option(arguments, name):
    if name in arguments and arguments.index(name) + 1 < len(arguments):
        return arguments[arguments.index(name) + 1]
    return None


def options(arguments, name):
    return [arguments[index + 1] for index, word in enumerate(arguments[:-1]) if word == name]


def fields(arguments):
    """The `-f name=value` and `-F name=value` of `gh api`."""
    found = {}
    for flag, word in zip(arguments, arguments[1:]):
        if flag in ("-f", "-F") and "=" in word:
            name, value = word.split("=", 1)
            found[name] = value
    return found


def body(arguments):
    if option(arguments, "--body-file") == "-":
        return sys.stdin.read()
    return option(arguments, "--body") or option(arguments, "--comment") or ""


def new_id(state, prefix):
    state["next_id"] += 1
    return f"{prefix}_{state['next_id']}"


def find(state, arguments):
    """The pull request a command names by number, or the open one of the branch checked out."""
    numbers = [word for word in arguments[2:] if word.isdigit()]
    if numbers:
        pull = numbered(state, int(numbers[0]))
    else:
        branch = git("rev-parse", "--abbrev-ref", "HEAD")
        mine = [pull for pull in state["pulls"] if pull["head"] == branch]
        pull = next((pull for pull in reversed(mine) if pull["state"] == "OPEN"), mine[-1] if mine else None)
    if pull is None:
        fail("no pull requests found for this branch")
    return pull


def numbered(state, number):
    return next((pull for pull in state["pulls"] if pull["number"] == number), None)


def url(pull):
    return f"{REPOSITORY}/pull/{pull['number']}"


def opened(state, title, text, head, base):
    pull = {
        "number": max([pull["number"] for pull in state["pulls"]] + [6]) + 1,
        "title": title, "body": text, "head": head, "base": base, "state": "OPEN", "isDraft": False,
        "mergeable": "MERGEABLE", "reviewDecision": None, "behindBy": 0, "autoMerge": None,
        "checks": [["build", "success"], ["test", "success"]],
        "createdAt": now(), "updatedAt": now(), "mergedAt": None, "closedAt": None, "mergedBy": None,
        "headOid": git("rev-parse", head) or "0" * 40, "comments": [], "reviews": [], "threads": [],
        "labels": [], "requested": [], "viewed": [],
    }
    state["pulls"].append(pull)
    return pull


def commits(pull):
    listing = git("log", "--reverse", "--format=%H%x09%h%x09%s%x09%an%x09%cI", f"{pull['base']}..{pull['head']}")
    found = []
    for line in listing.splitlines():
        sha, oid, headline, author, at = line.split("\t")
        found.append({"commit": {"oid": sha, "abbreviatedOid": oid, "messageHeadline": headline, "committedDate": at,
                                 "author": {"name": author, "user": {"login": USER}}}})
    return found


def check(name, status):
    finished = status not in ("pending", "queued", "in_progress")
    return {
        "__typename": "CheckRun", "name": name, "status": "COMPLETED" if finished else "IN_PROGRESS",
        "conclusion": status.upper() if finished else None, "detailsUrl": f"{REPOSITORY}/actions/runs/1",
        "startedAt": now(), "checkSuite": {"workflowRun": {"workflow": {"name": "CI"}}},
    }


def reacted(state, subject):
    """What GitHub's API says of the reactions to a comment, a review or a review comment."""
    given = {**subject, "reactionGroups": []}
    for content in REACTIONS:
        users = state["reactions"].get(subject["id"], {}).get(content, [])
        given["reactionGroups"].append(
            {"content": content, "viewerHasReacted": USER in users, "reactors": {"totalCount": len(users)}})
    return given


def labelled(state, names):
    colours = {label["name"]: label["color"] for label in state["labels"]}
    return [{"name": name, "color": colours.get(name, "cccccc")} for name in names]


def latest_reviews(pull):
    latest = {}
    for review in pull["reviews"]:
        latest[review["author"]["login"]] = review["state"]
    return [{"author": {"login": author}, "state": verdict} for author, verdict in latest.items()]


def files(pull):
    paths = git("diff", "--name-only", f"{pull['base']}...{pull['head']}").splitlines()
    return [{"path": path, "viewerViewedState": "VIEWED" if path in pull["viewed"] else "UNVIEWED"} for path in paths]


def detail(state, number):
    pull = numbered(state, number)
    if pull is None:
        return {"data": {"viewer": {"login": USER}, "repository": {"pullRequest": None}}}
    allowed = state["merge_methods"]
    found = {
        "id": f"PR_{pull['number']}", "number": pull["number"], "title": pull["title"], "url": url(pull),
        "body": pull["body"], "state": pull["state"], "isDraft": pull["isDraft"], "mergeable": pull["mergeable"],
        "reviewDecision": pull["reviewDecision"], "additions": 0, "deletions": 0, "changedFiles": 0,
        "createdAt": pull["createdAt"], "mergedAt": pull["mergedAt"], "closedAt": pull["closedAt"],
        "baseRefName": pull["base"], "headRefName": pull["head"], "author": {"login": USER},
        "mergedBy": {"login": pull["mergedBy"]} if pull["mergedBy"] else None,
        "autoMergeRequest": {"mergeMethod": pull["autoMerge"]} if pull["autoMerge"] else None,
        "viewerCanUpdate": True, "viewerDidAuthor": True, "viewerCanUpdateBranch": True,
        "baseRef": {"compare": {"behindBy": pull["behindBy"]}},
        "labels": {"nodes": labelled(state, pull["labels"])},
        "reviewRequests": {"nodes": [{"requestedReviewer": {"__typename": "User", "login": login}}
                                     for login in pull["requested"]]},
        "latestReviews": {"nodes": latest_reviews(pull)},
        "files": {"nodes": files(pull)},
        "commits": {"totalCount": 0, "nodes": commits(pull)},
        "lastCommit": {"nodes": [{"commit": {"statusCheckRollup": {"contexts": {
            "nodes": [check(name, status) for name, status in pull["checks"]]}}}}]},
        "comments": {"nodes": [reacted(state, comment) for comment in pull["comments"]]},
        "reviews": {"nodes": [reacted(state, review) for review in pull["reviews"]]},
        "reviewThreads": {"nodes": [{**thread, "comments": {"nodes": [reacted(state, comment) for comment in
                                                                     thread["comments"]]}}
                                    for thread in pull["threads"]]},
    }
    found["commits"]["totalCount"] = len(found["commits"]["nodes"])
    stat = git("diff", "--shortstat", f"{pull['base']}...{pull['head']}")
    numbers = [int(word) for word in stat.replace(",", "").split() if word.isdigit()]
    for key, value in zip(["changedFiles", "additions", "deletions"], numbers + [0, 0, 0]):
        found[key] = value
    return {"data": {"viewer": {"login": USER}, "repository": {
        "mergeCommitAllowed": "MERGE" in allowed, "squashMergeAllowed": "SQUASH" in allowed,
        "rebaseMergeAllowed": "REBASE" in allowed, "autoMergeAllowed": state["auto_merge"],
        "viewerPermission": "ADMIN", "viewerDefaultMergeMethod": state["preferred"],
        "defaultBranchRef": {"name": "main"},
        "labels": {"nodes": state["labels"]},
        "assignableUsers": {"nodes": [{"login": login} for login in state["users"]]},
        "pullRequest": found,
    }}}


def thread_of(state, thread_id):
    for pull in state["pulls"]:
        for thread in pull["threads"]:
            if thread["id"] == thread_id:
                return pull, thread
    fail(f"Could not resolve to a node with the global id of '{thread_id}'")


def mutation(state, query, variables):
    if "addReaction" in query or "removeReaction" in query:
        users = state["reactions"].setdefault(variables["subject"], {}).setdefault(variables["content"], [])
        if "addReaction" in query and USER not in users:
            users.append(USER)
        if "removeReaction" in query and USER in users:
            users.remove(USER)
    elif "addPullRequestReviewThreadReply" in query:
        pull, thread = thread_of(state, variables["thread"])
        thread["comments"].append({"id": new_id(state, "PRRC"), "author": {"login": USER}, "body": variables["body"],
                                   "createdAt": now(), "url": url(pull), "diffHunk": None})
    elif "resolveReviewThread" in query or "unresolveReviewThread" in query:
        thread_of(state, variables["thread"])[1]["isResolved"] = "unresolveReviewThread" not in query
    elif "markFileAsViewed" in query or "unmarkFileAsViewed" in query:
        pull = numbered(state, int(variables["id"].split("_")[1]))
        viewed = set(pull["viewed"])
        (viewed.discard if "unmarkFileAsViewed" in query else viewed.add)(variables["path"])
        pull["viewed"] = sorted(viewed)
    else:
        fail("unknown mutation")
    save(state)
    print(json.dumps({"data": {}}))


def review(state, number):
    """A review with comments on lines, as `POST …/pulls/<n>/reviews` makes it."""
    pull = numbered(state, number)
    asked = json.loads(sys.stdin.read())
    verdict = {"APPROVE": "APPROVED", "REQUEST_CHANGES": "CHANGES_REQUESTED"}.get(asked["event"], "COMMENTED")
    pull["reviews"].append({"id": new_id(state, "PRR"), "author": {"login": USER}, "body": asked.get("body", ""),
                            "state": verdict, "submittedAt": now(), "url": url(pull)})
    for comment in asked.get("comments", []):
        pull["threads"].append({
            "id": new_id(state, "PRRT"), "isResolved": False, "isOutdated": False, "path": comment["path"],
            "line": comment["line"], "diffSide": comment["side"],
            "comments": [{"id": new_id(state, "PRRC"), "author": {"login": USER}, "body": comment["body"],
                          "createdAt": now(), "url": url(pull), "diffHunk": None}],
        })
    if verdict != "COMMENTED":
        pull["reviewDecision"] = verdict
    save(state)
    print(json.dumps({"id": 1}))


def listed(state, arguments):
    wanted = option(arguments, "--state") or "open"
    head = option(arguments, "--head")
    states = {"open": ["OPEN"], "closed": ["CLOSED"], "merged": ["MERGED"], "all": ["OPEN", "CLOSED", "MERGED"]}
    found = [pull for pull in reversed(state["pulls"])
             if pull["state"] in states[wanted] and (head is None or pull["head"] == head)]
    rows = []
    for pull in found[: int(option(arguments, "--limit") or 30)]:
        rows.append({
            "number": pull["number"], "title": pull["title"], "url": url(pull), "state": pull["state"],
            "isDraft": pull["isDraft"], "author": {"login": USER}, "headRefName": pull["head"],
            "baseRefName": pull["base"], "updatedAt": pull.get("updatedAt", pull["createdAt"]),
            "reviewDecision": pull["reviewDecision"] or "",
            "statusCheckRollup": [check(name, status) for name, status in pull["checks"]],
            "additions": 0, "deletions": 0,
        })
    print(json.dumps(rows))


def api(state, arguments):
    path = arguments[1]
    if "/stacks" in path:
        number = int(path.split("pull_request=")[1])
        print(json.dumps([stack for stack in state["stacks"]
                          if any(layer["number"] == number for layer in stack["pull_requests"])][:1]))
    elif "/commits/" in path:
        sha = path.rsplit("/", 1)[1]
        print(git("diff", f"{sha}^", sha))
    elif "/issues/" in path:
        number = int(path.rsplit("/", 1)[1])
        pull = next((pull for pull in state["pulls"] if pull["number"] == number), None)
        if pull is None:
            sys.exit("gh: Not Found (HTTP 404)")
        print(json.dumps({"title": pull["title"], "body": pull.get("body", "")}))
    elif path.endswith("/reviews"):
        review(state, int(path.split("/pulls/")[1].split("/")[0]))
    else:
        print("[]")


def main(arguments):
    command = " ".join(arguments[:2])
    if arguments[:1] == ["--version"]:
        print("gh version 2.0.0 (fake)")
        return
    if command == "auth token":
        print("fake-token")
        return
    state = load()
    if command == "api graphql":
        variables = fields(arguments)
        query = variables.pop("query", "")
        if query.lstrip().startswith("mutation"):
            mutation(state, query, variables)
        else:
            print(json.dumps(detail(state, int(variables["number"]))))
        return
    if arguments[:1] == ["api"]:
        api(state, arguments)
        return
    if command == "pr list":
        listed(state, arguments)
        return
    if command == "pr create":
        head = git("rev-parse", "--abbrev-ref", "HEAD")
        base = git("config", f"branch.{head}.gh-merge-base") or "main"
        pull = opened(state, option(arguments, "--title") or head, body(arguments), head, base)
        pull["isDraft"] = "--draft" in arguments
        save(state)
        print(url(pull))
        return
    pull = find(state, arguments)
    if command == "pr view":
        wanted = (option(arguments, "--json") or "").split(",")
        # A merged or closed pull request keeps the commit it ended at.
        head = pull["headOid"] if pull["state"] != "OPEN" else git("rev-parse", pull["head"]) or pull["headOid"]
        view = {"number": pull["number"], "title": pull["title"], "url": url(pull), "state": pull["state"],
                "isDraft": pull["isDraft"], "headRefOid": head}
        print(json.dumps({field: view.get(field) for field in wanted}))
        return
    if command == "pr diff":
        print(git("diff", f"{pull['base']}...{pull['head']}"))
        return
    open_only = {"pr merge", "pr ready", "pr close", "pr update-branch"}
    if command in open_only and pull["state"] != "OPEN":
        fail(f"Pull request #{pull['number']} is not open")
    if command == "pr merge":
        if "--disable-auto" in arguments:
            pull["autoMerge"] = None
        else:
            method = next((name.upper() for name in ("merge", "squash", "rebase") if f"--{name}" in arguments), "MERGE")
            if method not in state["merge_methods"]:
                fail(f"{method.lower()} merges are not allowed on this repository")
            if pull["mergeable"] == "CONFLICTING":
                fail(f"Pull request #{pull['number']} is not mergeable: the merge commit cannot be cleanly created.")
            waits = any(status != "success" for _, status in pull["checks"])
            if "--auto" in arguments and waits:
                pull["autoMerge"] = method
            else:
                pull.update(state="MERGED", mergedAt=now(), closedAt=now(), mergedBy=USER, autoMerge=None,
                            headOid=git("rev-parse", pull["head"]) or pull["headOid"])
    elif command == "pr ready":
        pull["isDraft"] = "--undo" in arguments
    elif command == "pr close":
        pull.update(state="CLOSED", closedAt=now(), headOid=git("rev-parse", pull["head"]) or pull["headOid"])
    elif command == "pr reopen":
        pull.update(state="OPEN", closedAt=None)
    elif command == "pr update-branch":
        pull["behindBy"] = 0
    elif command == "pr revert":
        if pull["state"] != "MERGED":
            fail(f"Pull request #{pull['number']} is not merged")
        reverting = opened(state, f"Revert \"{pull['title']}\"", f"Reverts #{pull['number']}", f"revert-{pull['number']}", pull["base"])
        save(state)
        print(url(reverting))
        return
    elif command == "pr review":
        verdict = "APPROVED" if "--approve" in arguments else "CHANGES_REQUESTED" if "--request-changes" in arguments else "COMMENTED"
        pull["reviews"].append({"id": new_id(state, "PRR"), "author": {"login": USER}, "body": body(arguments),
                                "state": verdict, "submittedAt": now(), "url": url(pull)})
        if verdict != "COMMENTED":
            pull["reviewDecision"] = verdict
    elif command == "pr edit":
        if option(arguments, "--title"):
            pull["title"] = option(arguments, "--title")
        if option(arguments, "--body-file") == "-":
            pull["body"] = sys.stdin.read()
        known = {label["name"] for label in state["labels"]}
        for name in options(arguments, "--add-label"):
            if name not in known:
                fail(f"'{name}' not found")
            pull["labels"] = sorted(set(pull["labels"]) | {name})
        pull["labels"] = [name for name in pull["labels"] if name not in options(arguments, "--remove-label")]
        for login in options(arguments, "--add-reviewer"):
            if login not in state["users"]:
                fail(f"'{login}' not found")
            pull["requested"] = sorted(set(pull["requested"]) | {login})
        pull["requested"] = [login for login in pull["requested"] if login not in options(arguments, "--remove-reviewer")]
    elif command != "pr comment":
        fail(f"unknown command {command}")
    text = body(arguments) if command in ("pr comment", "pr close", "pr reopen") else ""
    if text:
        pull["comments"].append({"id": new_id(state, "IC"), "author": {"login": USER}, "body": text,
                                 "createdAt": now(), "url": url(pull)})
    pull["updatedAt"] = now()
    save(state)


main(sys.argv[1:])
