#!/usr/bin/env python3
"""Stand-in for the `claude` and `codex` CLIs, for tests and screenshots.

By default it replays a recorded transcript: FAKE_AGENT_FIXTURE names a .jsonl file recorded with
`claude -p --output-format stream-json --verbose --include-partial-messages`, or the notifications
of a turn of `codex app-server`.
With `--input-format stream-json` the prompt is the first JSON line on stdin, as Claude Code reads
it, and the process stays until stdin closes. A prompt written while a turn runs is read after the
turn's next tool call and repeated on stdout; one written with priority `now` while a reply streams
stops the reply, with a result that says so, and is answered in a turn of its own, as Claude Code
does. A prompt that comes once the turn has ended gets a turn of its own. Some prompts get a reply
made up on the spot instead:

- "long reply with a lot of code": steps with code inside a list, then ten large code blocks,
  streamed in small pieces.
- "rate limiter": a turn with thinking, tool calls and a reply that uses most of Markdown.
- "huge transcript": four hundred messages with code and tool calls, for a very long thread.
- "watch the deploy": a turn that starts a monitor. The process then stays, as Claude Code's does:
  it answers the prompts it is given, and FAKE_AGENT_WATCH seconds after the last one it says what
  the monitor saw and exits.
- "run greet.py": a turn that edits a file and runs it. With `--permission-mode default` it asks
  before each of the two and waits for the answer on stdin. Its reply ends with what it was told
  while it worked.
- "which color": a turn that asks the user a question and goes on with the answer.
- "plan the hello": a turn that presents a plan and, once that is approved, carries it out.
- "show the screenshot": a turn that writes `screenshot.png` in its folder and shows it in the reply.

Called as `app-server` it is Codex: it answers the requests that start a thread and its turns,
takes a prompt steered into a running turn after the turn's next tool call, and stops a turn when
asked. There "run greet.py" asks before each of the two under the `untrusted` approval policy,
"which color" asks its question, and "plan the hello" presents a plan and carries it out when told
to implement it.

Asked for a thread title (`--json-schema` for Claude Code, `--output-last-message` for Codex) it
answers with FAKE_AGENT_TITLE, and asked the same way for a commit message or a pull request's text
it writes one. FAKE_AGENT_ARGUMENTS_FILE records how it was called, one JSON array
per call, and what it was told while it ran, one JSON object each: the settings Claude Code was
told to change, and the threads and turns Codex was asked for.
"""
import json
import os
import queue
import struct
import sys
import threading
import time
import zlib

if "--version" in sys.argv:
    print("2.1.284 (Claude Code, fake)")
    sys.exit(0)


arguments_file = os.environ.get("FAKE_AGENT_ARGUMENTS_FILE")


def record(what):
    if arguments_file:
        with open(arguments_file, "a") as f:
            f.write(json.dumps(what) + "\n")


# What stdin brings while the process runs: prompts, and answers to what it asked. `None` ends each.
prompts = queue.Queue()
answers = queue.Queue()


def read_stdin():
    for line in sys.stdin:
        if not line.strip():
            continue
        message = json.loads(line)
        if message["type"] == "user":
            prompts.put(message)
        if message["type"] == "control_response":
            answers.put(message)
        if message["type"] == "control_request":
            record(message["request"])
    prompts.put(None)
    answers.put(None)


def emit(event, pause=0.0):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()
    if pause:
        time.sleep(pause)


def take(message):
    """Repeats a prompt read from stdin, as `--replay-user-messages` does, and returns its text."""
    emit(dict(message, isReplay=True))
    return message["message"]["content"]


def take_waiting():
    """The prompts written while the turn worked, which Claude Code reads after a tool call."""
    taken = []
    while not prompts.empty():
        message = prompts.get()
        if message is None:
            prompts.put(None)
            break
        taken.append(take(message))
    return taken


def steer_waiting():
    """A prompt written with priority `now`, which stops a reply that streams."""
    if prompts.empty() or prompts.queue[0] is None or prompts.queue[0].get("priority") != "now":
        return None
    return prompts.get()


class Preempted(Exception):
    """The turn was stopped for the prompt it was given, which gets a turn of its own."""

    def __init__(self, message, session_id):
        self.message = message
        self.session_id = session_id


def read_prompt():
    if "--input-format" not in sys.argv:
        return sys.stdin.read()
    threading.Thread(target=read_stdin, daemon=True).start()
    message = prompts.get()
    return take(message) if message else ""


APP_SERVER = sys.argv[1:2] == ["app-server"]
prompt = "" if APP_SERVER else read_prompt()
record(sys.argv[1:])

delay = float(os.environ.get("FAKE_AGENT_DELAY", "0.02"))


def title_answer():
    if prompt.startswith("Write the git commit message"):
        subject = "Add the rate limiter" if "limiter" in prompt else "Greet with an f-string"
        return {"subject": subject + ".", "body": "", "branch": "Greet F-String"}
    if prompt.startswith("Write the title and the description of a pull request"):
        return {"title": "Greet with an f-string", "body": "Greets by name.\n\n" + prompt.split("Commits:")[-1].split("\n")[1]}
    if prompt.startswith("Regenerate"):
        return {"title": os.environ.get("FAKE_AGENT_REFINED_TITLE", "Refined From Transcript"), "needsRefinement": False}
    message = prompt.split("User message:")[-1].lower()
    title = "Use an F-String in Greet"
    if "rate limiter" in message:
        title = "Add API Rate Limiting"
    if "long reply" in message:
        title = "Long Reply With Code"
    if "huge transcript" in message:
        title = "Four Hundred Steps"
    if "watch the deploy" in message:
        title = "Watch the Deploy"
    if "show the screenshot" in message:
        title = "Screenshot of the Landing Page"
    return {"title": os.environ.get("FAKE_AGENT_TITLE", title), "needsRefinement": "fix this" in message}


if "--json-schema" in sys.argv:
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "structured_output": title_answer()}))
    sys.exit(0)

if "--output-last-message" in sys.argv:
    path = sys.argv[sys.argv.index("--output-last-message") + 1]
    with open(path, "w") as f:
        json.dump(title_answer(), f)
    sys.exit(0)


class Turn:
    """Writes Claude Code's stream-json for a scripted turn."""

    messages = 0

    def __init__(self, session_id, piece=24, pause=0.01):
        self.session_id = session_id
        self.piece = piece
        self.pause = pause
        # What the user said while the turn worked.
        self.told = []
        emit({"type": "system", "subtype": "init", "session_id": session_id})

    def _start(self):
        Turn.messages += 1
        message_id = f"msg_{self.messages:04d}"
        emit({"type": "stream_event", "event": {"type": "message_start", "message": {"id": message_id}}})
        return message_id

    def thinking(self, seconds):
        message_id = self._start()
        block = {"type": "thinking", "thinking": ""}
        emit({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": block}})
        time.sleep(seconds)
        emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}})
        return message_id

    def text(self, text):
        message_id = self._start()
        block = {"type": "text", "text": ""}
        emit({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": block}})
        for start in range(0, len(text), self.piece):
            steer = steer_waiting()
            if steer:
                emit({"type": "assistant", "message": {"id": message_id, "content": [{"type": "text", "text": text[:start]}]}})
                self.done(terminal_reason="aborted_streaming")
                raise Preempted(steer, self.session_id)
            delta = {"type": "text_delta", "text": text[start:start + self.piece]}
            emit({"type": "stream_event", "event": {"type": "content_block_delta", "index": 0, "delta": delta}}, self.pause)
        emit({"type": "assistant", "message": {"id": message_id, "content": [{"type": "text", "text": text}]}})
        emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}})

    def tool(self, name, tool_input, output, seconds=0.25, is_error=False, ask=False):
        """Makes the tool call, after asking when `ask` is set. Says whether it was made."""
        message_id = self._start()
        tool_id = f"toolu_{self.messages:04d}"
        block = {"type": "tool_use", "id": tool_id, "name": name, "input": {}}
        emit({"type": "stream_event", "event": {"type": "content_block_start", "index": 0, "content_block": block}})
        block = dict(block, input=tool_input)
        emit({"type": "assistant", "message": {"id": message_id, "content": [block]}})
        emit({"type": "stream_event", "event": {"type": "content_block_stop", "index": 0}}, seconds)
        answer = self._answer(name, tool_input, tool_id) if ask else {"behavior": "allow"}
        allowed = answer["behavior"] == "allow"
        if not allowed:
            output, is_error = "The user refused this.", True
        if callable(output):
            output = output(answer)
        result = {"type": "tool_result", "tool_use_id": tool_id, "content": output, "is_error": is_error}
        emit({"type": "user", "message": {"content": [result]}})
        self.told += take_waiting()
        return allowed

    def _answer(self, name, tool_input, tool_id):
        request = {"subtype": "can_use_tool", "tool_name": name, "input": tool_input, "tool_use_id": tool_id}
        emit({"type": "control_request", "request_id": f"request_{self.messages:04d}", "request": request})
        answer = answers.get()
        if not answer:
            sys.exit(0)
        return answer["response"]["response"]

    def done(self, terminal_reason="completed"):
        emit({"type": "result", "subtype": "success", "is_error": False, "duration_ms": 1, "total_cost_usd": 0.0412,
              "permission_denials": [], "terminal_reason": terminal_reason})


def long_reply():
    function = "\n".join(
        f"    if value % {n + 2} == 0:\n        total += compute(value, {n})  # step {n}\n        log(f\"step {n}: {{total}}\")"
        for n in range(40)
    )
    blocks = [
        f"Part {part} of the change:\n\n```python\ndef handle_{part}(value):\n    total = 0\n{function}\n    return total\n```\n"
        for part in range(1, 11)
    ]
    steps = """Try it first:

1. **Install it** (on the server):

   ```sh
   pip install -e .
   python -m handlers --check      # or HANDLERS_CHECK=1 if that's set
   ```

   The check reads `handlers.toml`. Run it as the user who owns the checkout.
2. **Call one handler**:

   ```python
   from handlers import handle_1
   assert handle_1(6) > 0
   ```
3. Read the change below.

"""
    turn = Turn("00000000-0000-4000-8000-00000000beef", piece=48, pause=0.003)
    turn.text(steps + "Here is the whole change, file by file.\n\n" + "\n".join(blocks) + "\nThat is everything.")
    turn.done()


RATE_LIMITER_RS = '''use std::time::{Duration, Instant};

/// A token bucket: `capacity` requests at once, refilled at `per_second`.
pub struct RateLimiter {
    capacity: f64,
    tokens: f64,
    per_second: f64,
    refilled: Instant,
}

impl RateLimiter {
    pub fn new(capacity: u32, per_second: f64) -> Self {
        Self { capacity: capacity as f64, tokens: capacity as f64, per_second, refilled: Instant::now() }
    }

    /// Takes one token, or says how long to wait for the next.
    pub fn check(&mut self) -> Result<(), Duration> {
        let elapsed = self.refilled.elapsed().as_secs_f64();
        self.tokens = (self.tokens + elapsed * self.per_second).min(self.capacity);
        self.refilled = Instant::now();
        if self.tokens >= 1.0 {
            self.tokens -= 1.0;
            return Ok(());
        }
        Err(Duration::from_secs_f64((1.0 - self.tokens) / self.per_second))
    }
}'''

RATE_LIMITER_REPLY = f'''The API now limits each client to **20 requests per second**, with bursts of up to 60. Limited requests get `429 Too Many Requests` and a `Retry-After` header.

## What changed

- `src/rate_limit.rs` is new: a token bucket per client key.
- `src/middleware.rs` checks the bucket before the handler runs.
- The limits come from `RATE_LIMIT_BURST` and `RATE_LIMIT_PER_SECOND`, so they can change without a deploy.

```rust
{RATE_LIMITER_RS}
```

The middleware keys clients by API token, and by address when there is none:

```typescript
export async function rateLimit(request: Request, next: Handler): Promise<Response> {{
  const key = request.headers.get("authorization") ?? clientAddress(request);
  const wait = limiter.check(key);
  if (wait === null) return next(request);

  return new Response("Too many requests", {{
    status: 429,
    headers: {{ "retry-after": String(Math.ceil(wait / 1000)) }},
  }});
}}
```

## How it behaves

| Client sends | Result |
| --- | --- |
| 20 requests per second, steadily | All pass |
| 60 at once, then nothing for 3 s | All pass, bucket refills |
| 100 at once | 60 pass, 40 get `429` with `Retry-After: 1` |

1. All 14 tests pass, including three new ones for the bucket.
2. I didn't touch the websocket endpoint; it has no limit yet.

> The bucket lives in memory, so each instance limits separately. With three instances a client can reach 60 requests per second in total.
'''


def rate_limiter():
    turn = Turn("00000000-0000-4000-8000-00000000cafe")
    turn.thinking(0.6)
    turn.text("I'll look at how requests reach the handlers first.")
    turn.tool("Grep", {"pattern": "fn handle_request", "path": "src"}, "src/server.rs:41:pub async fn handle_request(")
    turn.tool("Read", {"file_path": "/srv/api/src/middleware.rs"}, "1\tuse crate::server::Handler;\n2\t\n3\tpub mod auth;\n4\tpub mod logging;\n")
    turn.text("There is a middleware chain already, so the limiter fits in as one more link.")
    turn.tool("Write", {"file_path": "/srv/api/src/rate_limit.rs", "content": RATE_LIMITER_RS}, "File created successfully at: /srv/api/src/rate_limit.rs")
    edit = {"file_path": "/srv/api/src/middleware.rs", "old_string": "pub mod auth;\npub mod logging;",
            "new_string": "pub mod auth;\npub mod logging;\npub mod rate_limit;"}
    turn.tool("Edit", edit, "The file /srv/api/src/middleware.rs has been updated successfully.")
    tests = "running 14 tests\ntest rate_limit::tests::burst_is_allowed ... ok\ntest rate_limit::tests::refills_over_time ... ok\ntest rate_limit::tests::says_how_long_to_wait ... ok\n\ntest result: ok. 14 passed; 0 failed; finished in 0.42s"
    turn.tool("Bash", {"command": "cargo test --quiet", "description": "Run the tests"}, tests, seconds=0.8)
    turn.text(RATE_LIMITER_REPLY)
    turn.done()


def huge_transcript():
    """Hundreds of short messages, code blocks and tool calls, as fast as they can be written."""
    turn = Turn("00000000-0000-4000-8000-00000000f00d", piece=4000, pause=0)
    for n in range(1, 401):
        turn.text(f"Step {n}: `step_{n}` doubles its input and adds one.\n\n```rust\nfn step_{n}(input: u32) -> u32 {{\n    let doubled = input * 2;\n    doubled + 1\n}}\n```\n")
        turn.tool("Bash", {"command": f"cargo test step_{n}"}, f"test step_{n} ... ok", seconds=0)
    turn.text("All 400 steps are in place and their tests pass.")
    turn.done()


def watch_the_deploy():
    session_id = "00000000-0000-4000-8000-00000000d00d"

    def background(tasks):
        emit({"type": "system", "subtype": "background_tasks_changed", "tasks": tasks})

    turn = Turn(session_id)
    command = "until curl -sf https://api.example.com/health; do sleep 5; done; echo healthy"
    turn.tool("Monitor", {"command": command, "description": "deploy status"},
              "Monitor started (task b1). You will be notified on each event.")
    background([{"task_id": "b1", "task_type": "local_bash", "description": "deploy status"}])
    turn.text("The deploy is rolling out. I'm watching it and will tell you when it is healthy.")
    turn.done()

    while True:
        try:
            message = prompts.get(timeout=float(os.environ.get("FAKE_AGENT_WATCH", "2")))
        except queue.Empty:
            break
        if message is None:
            sys.exit(0)
        said = take(message)
        turn = Turn(session_id)
        turn.text(f"Still rolling out; 2 of 3 services are up. You said: {said}")
        turn.done()

    background([])
    turn = Turn(session_id)
    turn.text("The deploy finished: all 3 services are healthy.")
    turn.done()


def run_greet():
    asks = "default" in sys.argv
    turn = Turn("00000000-0000-4000-8000-00000000a5c0")
    turn.text("I'll switch `greet` to an f-string and run it.")
    edit = {"file_path": "/srv/api/greet.py", "old_string": 'return "Hello, " + name + "!"',
            "new_string": 'return f"Hello, {name}!"'}
    edited = turn.tool("Edit", edit, "The file /srv/api/greet.py has been updated successfully.", ask=asks)
    ran = edited and turn.tool("Bash", {"command": "python3 greet.py", "description": "Run greet.py"},
                               "Hello, world!", ask=asks)
    told = "".join(f" You also said: {said}" for said in turn.told)
    if ran:
        turn.text("`greet` uses an f-string now, and running it prints `Hello, world!`." + told)
    elif edited:
        turn.text("`greet` uses an f-string now. I didn't run it." + told)
    else:
        turn.text("I left `greet.py` as it was." + told)
    turn.done()


def which_color():
    turn = Turn("00000000-0000-4000-8000-0000000c0102")
    options = [{"label": "Red", "description": "Stands out on the page"},
               {"label": "Blue", "description": "Matches the rest of the app"}]
    question = {"question": "Which color should the button be?", "header": "Color", "options": options,
                "multiSelect": False}
    chosen = {}

    def answered(answer):
        chosen.update(answer["updatedInput"]["answers"])
        return "Your questions have been answered."

    if turn.tool("AskUserQuestion", {"questions": [question]}, answered, ask=True):
        turn.text(f"The button will be {chosen[question['question']].lower()}.")
    else:
        turn.text("I'll leave the button as it is.")
    turn.done()


def plan_hello():
    turn = Turn("00000000-0000-4000-8000-00000000b1a0")
    turn.tool("Read", {"file_path": "/srv/api/hello.py"}, "1\tdef main():\n2\t    pass\n")
    plan = "## Add a greeting\n\n1. Add `hello()` to `hello.py`, which prints the greeting.\n2. Call it from `main()`.\n3. Run the file to see it.\n"
    mode = {}

    def approved(answer):
        mode.update(answer["updatedPermissions"][0])
        return "User has approved your plan. You can now start coding."

    if turn.tool("ExitPlanMode", {"plan": plan}, approved, ask=True):
        turn.tool("Write", {"file_path": "/srv/api/hello.py", "content": 'def hello():\n    print("Hello!")\n'},
                  "File created successfully at: /srv/api/hello.py")
        turn.text(f"`hello()` is in place. I worked in {mode['mode']} mode.")
    else:
        turn.text("I'll keep planning. What should change?")
    turn.done()


def png(width, height):
    """A picture of that size: a page with a bar across its top."""
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    bar = b"\x00" + bytes((36, 99, 235)) * width
    page = b"\x00" + bytes((244, 245, 247)) * width
    rows = b"".join(bar if row < height // 6 else page for row in range(height))
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b"")


def show_screenshot():
    turn = Turn("00000000-0000-4000-8000-0000000005c7")
    path = os.path.join(os.getcwd(), "screenshot.png")
    with open(path, "wb") as f:
        f.write(png(960, 600))
    command = "npx playwright screenshot http://localhost:3000 screenshot.png"
    turn.tool("Bash", {"command": command, "description": "Take a screenshot"}, "Saved screenshot.png", seconds=0.1)
    turn.text(f"Here is the page as it looks now:\n\n![The landing page]({path})\n\nThe header is in place.")
    turn.done()


class Stopped(Exception):
    """The turn was asked to stop."""


class Codex:
    """Speaks the JSON-RPC of `codex app-server` for one thread."""

    THREAD = "01a0f557-4a9b-74a0-b330-f6c4d13b2880"

    def __init__(self):
        # Ids are unique in a thread, also across the processes that resume it.
        self.process = os.urandom(4).hex()
        self.prompts = queue.Queue()
        self.answers = queue.Queue()
        self.stopping = threading.Event()
        self.thread = {}
        self.turns = 0
        self.items = 0
        self.requests = 0
        self.told = []

    def read(self):
        for line in sys.stdin:
            message = json.loads(line)
            method, params = message.get("method"), message.get("params") or {}
            if method is None:
                self.answers.put(message)
            if method == "initialize":
                emit({"id": message["id"], "result": {}})
            if method in ("thread/start", "thread/resume"):
                record({method: params})
                self.thread = params
                thread = {"id": params.get("threadId", self.THREAD)}
                emit({"id": message["id"], "result": {"thread": thread, "model": params.get("model") or "gpt-fake"}})
            if method == "turn/start":
                record({method: params})
                emit({"id": message["id"], "result": {"turn": {"id": self.turn_id(), "status": "inProgress"}}})
                self.prompts.put(params)
            if method == "turn/steer":
                record({method: params})
                emit({"id": message["id"], "result": {"turnId": params["expectedTurnId"]}})
                self.prompts.put(params)
            if method == "turn/interrupt":
                emit({"id": message["id"], "result": {}})
                self.stopping.set()
        self.prompts.put(None)
        self.answers.put(None)

    def turn_id(self):
        return f"turn-{self.process}-{max(self.turns, 1)}"

    def notify(self, method, **params):
        emit({"method": method, "params": params})

    def pause(self, seconds):
        if self.stopping.wait(seconds):
            raise Stopped()

    def item(self, kind, **fields):
        self.items += 1
        return dict(fields, type=kind, id=f"item-{self.process}-{self.items}")

    def user_message(self, params):
        item = self.item("userMessage", clientId=params.get("clientUserMessageId"), content=params["input"])
        self.notify("item/started", item=item)
        self.notify("item/completed", item=item)
        return params["input"][0]["text"]

    def take_waiting(self):
        """The prompts written while the turn worked, which Codex reads after a tool call."""
        while not self.prompts.empty():
            params = self.prompts.get()
            if params is None:
                self.prompts.put(None)
                return
            self.told.append(self.user_message(params))

    def ask(self, method, **params):
        """Asks and waits for the answer, or for the turn to be stopped."""
        self.requests += 1
        emit({"id": self.requests, "method": method, "params": params})
        while True:
            try:
                answer = self.answers.get(timeout=0.05)
            except queue.Empty:
                self.pause(0)
                continue
            if answer is None:
                sys.exit(0)
            self.notify("serverRequest/resolved", requestId=self.requests)
            return answer["result"]

    def asks(self):
        return self.thread.get("approvalPolicy") == "untrusted"

    def text(self, text, piece=24):
        item = self.item("agentMessage", text="")
        self.notify("item/started", item=item)
        for start in range(0, len(text), piece):
            self.notify("item/agentMessage/delta", itemId=item["id"], delta=text[start:start + piece])
            self.pause(0.003)
        self.notify("item/completed", item=dict(item, text=text))

    def work(self, item, method, done, seconds=0.25, **asked):
        """Does what `item` says, after asking when the thread is supervised. Says whether it was done."""
        self.notify("item/started", item=dict(item, status="inProgress"))
        self.pause(seconds)
        allowed = not self.asks() or self.ask(method, itemId=item["id"], **asked)["decision"] == "accept"
        self.notify("item/completed", item=dict(item, status="completed", **done) if allowed else dict(item, status="declined"))
        self.take_waiting()
        return allowed

    def command(self, command, output, **timing):
        shell = f"/bin/bash -lc '{command}'"
        item = self.item("commandExecution", command=shell, aggregatedOutput=None, exitCode=None)
        done = {"aggregatedOutput": output, "exitCode": 0}
        return self.work(item, "item/commandExecution/requestApproval", done, command=shell, **timing)

    def edit(self, path, kind, diff):
        item = self.item("fileChange", changes=[{"path": path, "kind": {"type": kind}, "diff": diff}])
        return self.work(item, "item/fileChange/requestApproval", {})

    def run_greet(self, params):
        self.text("I'll switch `greet` to an f-string and run it.")
        edited = self.edit("/srv/api/greet.py", "update", '-    return "Hello, " + name + "!"\n+    return f"Hello, {name}!"')
        ran = edited and self.command("python3 greet.py", "Hello, world!\n")
        told = "".join(f" You also said: {said}" for said in self.told)
        if ran:
            self.text("`greet` uses an f-string now, and running it prints `Hello, world!`." + told)
        elif edited:
            self.text("`greet` uses an f-string now. I didn't run it." + told)
        else:
            self.text("I left `greet.py` as it was." + told)

    def which_color(self, params):
        options = [{"label": "Red", "description": "Stands out on the page"},
                   {"label": "Blue", "description": "Matches the rest of the app"}]
        question = {"id": "color", "header": "Color", "question": "Which color should the button be?", "options": options}
        chosen = self.ask("item/tool/requestUserInput", itemId="call-color", questions=[question])["answers"]
        if "color" in chosen:
            self.text(f"The button will be {chosen['color']['answers'][0].lower()}.")
        else:
            self.text("I'll leave the button as it is.")

    def plan_hello(self, params):
        self.command("cat hello.py", "def main():\n    pass\n")
        plan = "## Add a greeting\n\n1. Add `hello()` to `hello.py`, which prints the greeting.\n2. Call it from `main()`.\n3. Run the file to see it.\n"
        item = self.item("plan", text="")
        self.notify("item/started", item=item)
        self.notify("item/completed", item=dict(item, text=plan))

    def implement(self, params):
        self.edit("/srv/api/hello.py", "add", 'def hello():\n    print("Hello!")\n')
        self.text(f"`hello()` is in place. I worked in {params['collaborationMode']['mode']} mode.")

    def long_reply(self, params):
        self.text("Here is the whole change.\n\n" + "A line of the change.\n" * 400)

    def replay_fixture(self, params):
        with open(os.environ["FAKE_AGENT_FIXTURE"]) as f:
            for line in f:
                message = json.loads(line)
                event = message["params"]
                item = event.get("item", {})
                if message["method"].startswith("turn/") or item.get("type") == "userMessage":
                    continue
                if "itemId" in event:
                    event["itemId"] = f"{self.process}-{event['itemId']}"
                if item:
                    item["id"] = f"{self.process}-{item['id']}"
                emit(message)
                self.pause(delay)
                if message["method"] == "item/completed" and "status" in item:
                    self.take_waiting()

    SCRIPTED = {
        "run greet.py": run_greet,
        "which color": which_color,
        "plan the hello": plan_hello,
        "implement the plan": implement,
        "long reply with a lot of code": long_reply,
    }

    def turn(self, params):
        self.turns += 1
        self.told = []
        self.stopping.clear()
        turn = {"id": self.turn_id(), "status": "inProgress", "error": None}
        self.notify("turn/started", turn=turn)
        said = self.user_message(params).lower()
        script = next((script for words, script in self.SCRIPTED.items() if words in said), Codex.replay_fixture)
        try:
            script(self, params)
            status = "completed"
        except Stopped:
            status = "interrupted"
        self.notify("turn/completed", turn=dict(turn, status=status))

    def serve(self):
        threading.Thread(target=self.read, daemon=True).start()
        while True:
            params = self.prompts.get()
            if params is None:
                return
            self.turn(params)


if APP_SERVER:
    Codex().serve()
    sys.exit(0)

SCRIPTED = {
    "show the screenshot": show_screenshot,
    "run greet.py": run_greet,
    "which color": which_color,
    "plan the hello": plan_hello,
    "watch the deploy": watch_the_deploy,
    "huge transcript": huge_transcript,
    "long reply with a lot of code": long_reply,
    "rate limiter": rate_limiter,
}


def replay_fixture():
    fixture = os.environ.get("FAKE_AGENT_FIXTURE") or os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "..", "fixtures", "edit-and-run.jsonl"
    )
    with open(fixture) as f:
        for line in f:
            sys.stdout.write(line)
            sys.stdout.flush()
            time.sleep(delay)
            if '"tool_result"' in line:
                take_waiting()


def answer(prompt):
    scripted = next((turn for words, turn in SCRIPTED.items() if words in prompt.lower()), replay_fixture)
    try:
        scripted()
    except Preempted as preempted:
        turn = Turn(preempted.session_id)
        said = take(preempted.message)
        turn.text("I stopped there. You also said: " + said)
        turn.done()


answer(prompt)
while "--input-format" in sys.argv:
    message = prompts.get()
    if message is None:
        break
    answer(take(message))
